# Browser-safe configuration only. Never place credentials in VITE_* variables.
VITE_SHROUDLY_DEPLOYMENT_ID=shroudly-preprod-<immutable-id>
VITE_SHROUDLY_RPC_URL=https://rpc.preprod.midnight.network
VITE_SHROUDLY_INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql
VITE_SHROUDLY_ZK_CONFIG_URL=
VITE_SHROUDLY_SPONSOR_URL=
VITE_SHROUDLY_ASSET_CONTRACT_ID=
VITE_SHROUDLY_RANDOMNESS_CONTRACT_ID=
VITE_SHROUDLY_YIELD_CONTRACT_ID=
VITE_SHROUDLY_POOL_CONTRACT_ID=
VITE_SHROUDLY_ASSET_ARTIFACT_HASH=
VITE_SHROUDLY_RANDOMNESS_ARTIFACT_HASH=
VITE_SHROUDLY_YIELD_ARTIFACT_HASH=
VITE_SHROUDLY_POOL_ARTIFACT_HASH=

# Server-side provider names only. Values belong in provider secret stores and
# are intentionally absent from this repository.
MIDNIGHT_DEPLOYER_SECRET_NAME=shroudly-preprod-deployer
MIDNIGHT_GOVERNANCE_SECRET_NAME=shroudly-preprod-governance
MIDNIGHT_RANDOMNESS_SECRET_NAME=shroudly-preprod-randomness
